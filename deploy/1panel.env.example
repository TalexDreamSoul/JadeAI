# Copy to .env next to docker-compose.1panel.yml on the 1Panel host.

JADEAI_IMAGE=ghcr.io/talexdreamsoul/jadeai:latest
APP_NAME=JadeAI

AUTH_ENABLED=true
AUTH_SECRET=change-me-use-openssl-rand-base64-32
# local | oidc-only | oidc-with-admin-password
AUTH_MODE=oidc-with-admin-password
# Public origin used by Auth.js/OIDC callbacks. Prevents 0.0.0.0 callback URLs.
AUTH_URL=https://resume.example.com
NEXTAUTH_URL=https://resume.example.com
PUBLIC_APP_URL=https://resume.example.com

# Ordinary users sign in with env-configured OIDC.
AUTH_OIDC_ENABLED=false
AUTH_OIDC_NAME=Company SSO
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# In oidc-with-admin-password mode, keep local password only for admins.
AUTH_PASSWORD_PUBLIC_ENABLED=false
AUTH_PASSWORD_REGISTER_ENABLED=false
AUTH_ADMIN_PASSWORD_ENABLED=true
# In oidc-only mode, emails listed here become admins after OIDC login.
ADMIN_EMAILS=
AUTH_FIRST_OIDC_USER_ADMIN=false

# sqlite (default)
DB_TYPE=sqlite
SQLITE_PATH=/app/data/touchresume.db

# postgresql (optional)
# DB_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@postgres:5432/touchresume

# Object Storage (optional). Admin backend can override these values.
STORAGE_PROVIDER=qiniu
QINIU_STORAGE_ENABLED=false
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_REGION=z0
QINIU_DOMAIN=
QINIU_PROTOCOL=https
QINIU_KEY_PREFIX=uploads
QINIU_PUBLIC_READ=true

# Unified AI (optional)
AI_PROVIDER=openai
AI_OPENAI_ENDPOINT=chat
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

IMAGE_AI_API_KEY=
IMAGE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_AI_MODEL=gemini-3.1-flash-image-preview

# Used by scripts/1panel-deploy.sh when exposed through a 1Panel webhook.
WEBHOOK_SECRET=change-me
APP_DIR=/opt/1panel/apps/jadeai
COMPOSE_FILE=docker-compose.yml
PROJECT_NAME=jadeai
APP_PORT=3003
HEALTH_TIMEOUT=90
DRAIN_SECONDS=10
