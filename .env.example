# ===== App =====
APP_NAME=TouchResume

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# OAuth Providers (prefix OAUTH_ or legacy names both work)
# Google
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
# GitHub
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
# Microsoft Entra ID (Azure AD)
OAUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=your-microsoft-client-secret

# ===== Database =====
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/touchresume

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/touchresume.db

# ===== Unified AI (optional) =====
# When configured, users can use this shared server-side AI config instead of entering their own key.
# AI_PROVIDER: openai | anthropic | gemini
# AI_OPENAI_ENDPOINT (only for AI_PROVIDER=openai): chat | responses
AI_PROVIDER=openai
AI_OPENAI_ENDPOINT=chat
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Unified image AI for professional photo generation (optional, Gemini image model)
IMAGE_AI_API_KEY=
IMAGE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_AI_MODEL=gemini-3.1-flash-image-preview

# ===== i18n =====
DEFAULT_LOCALE=zh
