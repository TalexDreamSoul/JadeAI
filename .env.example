# ===== App =====
APP_NAME=JadeAI
LEGAL_OPERATOR_NAME=JadeAI
LEGAL_CONTACT_EMAIL=privacy@tagzxia.com

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# Optional first administrator bootstrap. Remove ADMIN_PASSWORD after first login.
ADMIN_EMAIL=admin@jadeai.local
ADMIN_PASSWORD=

# Active payment adapter. Leave blank until a real provider is configured.
PAYMENT_PROVIDER=
# Mock checkout is development/test only: set PAYMENT_PROVIDER=mock and enable this flag.
ALLOW_MOCK_PAYMENTS=false

# Stripe Checkout (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
# Use false only with Stripe test-mode keys and events.
STRIPE_EXPECT_LIVEMODE=false
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_TIMEOUT_MS=10000
STRIPE_API_BASE_URL=https://api.stripe.com

# Required in production. Encrypts secrets stored in the database.
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Optional old key used only while rotating DATA_ENCRYPTION_KEY.
DATA_ENCRYPTION_KEY_PREVIOUS=

# Password login failure protection.
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Required by POST /api/internal/resume-analysis/tick when that worker is used.
RESUME_ANALYSIS_WORKER_TOKEN=

# Password auth env defaults (can also be toggled in admin panel)
# AUTH_PASSWORD_ENABLED=true
# AUTH_PASSWORD_REGISTER_ENABLED=true

# OAuth is configured purely in the admin backend.
# Use the Admin → Auth Settings panel to set up Google / GitHub / Microsoft.

# ===== Database =====
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/jadeai

# SQLite (when DB_TYPE=sqlite)
# Legacy filename is retained so existing installations keep their data after upgrading.
SQLITE_PATH=./data/touchresume.db

# ===== Object Storage (optional) =====
# Admin backend can override these values. Use Qiniu Cloud as the unified Bucket provider.
STORAGE_PROVIDER=qiniu
QINIU_STORAGE_ENABLED=false
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_REGION=z0
QINIU_DOMAIN=
QINIU_PROTOCOL=https
QINIU_KEY_PREFIX=uploads
QINIU_PUBLIC_READ=true

# ===== Unified AI (optional) =====
# When configured, users can use this shared server-side AI config instead of entering their own key.
# AI_PROVIDER: openai | anthropic | gemini
# AI_OPENAI_ENDPOINT (only for AI_PROVIDER=openai): chat | responses
AI_PROVIDER=openai
AI_OPENAI_ENDPOINT=chat
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Unified image AI for professional photo generation (optional, Gemini image model)
IMAGE_AI_API_KEY=
IMAGE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_AI_MODEL=gemini-3.1-flash-image-preview

# ===== i18n =====
DEFAULT_LOCALE=zh
